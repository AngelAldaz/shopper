# Normaliza los finales de linea: se guardan como LF en el repo aunque se
# trabaje desde Windows. Sin esto, el build de GitHub Actions (Linux) ve
# diferencias fantasma en archivos que nadie toco.
* text=auto eol=lf

# Binarios: que git no intente convertir nada.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary
